# 复制为 infra/.env 再按需修改；.env 不提交。以下值只用于本地开发。
GDCS_HOST=localhost

POSTGRES_USER=gdcs
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=gdcs

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me

# 默认：Caddy 内部证书（浏览器会提示不受信任）。
# 要给 Excel 加载项用：mkcert -install && mkcert -cert-file infra/caddy/certs/local.pem -key-file infra/caddy/certs/local-key.pem localhost
# 然后改成：CADDY_TLS=/certs/local.pem /certs/local-key.pem
CADDY_TLS=internal
