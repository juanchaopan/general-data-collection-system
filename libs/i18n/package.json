{
  "name": "@gdcs/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "arch": "node scripts/arch-check.mjs",
    "typecheck": "tsc --noEmit",
